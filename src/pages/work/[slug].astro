---
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { getWork, type Work } from '../../lib/work';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

interface Props {
  entry: Work;
  next: Work;
}

const { entry, next } = Astro.props;
---

<Base title={entry.data.title} description={entry.data.summary} type="article">
  <CaseStudy entry={entry} next={next}>
    <a slot="before" class="back mono" href="/#work">← All work</a>
  </CaseStudy>
</Base>
