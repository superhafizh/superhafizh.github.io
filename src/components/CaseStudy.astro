---
import { render } from 'astro:content';
import type { Work } from '../lib/work';

interface Props {
  entry: Work;
  next: Work;
  /** 1 on the standalone case page, 2 inside the homepage dialog. */
  level?: 1 | 2;
  titleId?: string;
}

const { entry, next, level = 1, titleId } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const Title = level === 1 ? 'h1' : 'h2';
---

<header class="case-head">
  <slot name="before" />
  <p class="eyebrow label">{d.org} · {d.period}</p>
  <Title class="case-title" id={titleId}>{d.title}</Title>
  <p class="lede">{d.summary}</p>
  <dl class="facts">
    <div>
      <dt class="label">Role</dt>
      <dd>{d.role}</dd>
    </div>
    <div>
      <dt class="label">Company</dt>
      <dd>{d.org}</dd>
    </div>
    <div>
      <dt class="label">Period</dt>
      <dd>{d.period}</dd>
    </div>
    <div>
      <dt class="label">Stack</dt>
      <dd>{d.stack.join(', ')}</dd>
    </div>
    {
      d.link && (
        <div>
          <dt class="label">Link</dt>
          <dd>
            <a href={d.link}>{new URL(d.link).hostname} ↗</a>
          </dd>
        </div>
      )
    }
  </dl>
</header>

<section class="section" aria-label="Case study">
  <p class="label" aria-hidden="true">Case study</p>
  <div class="prose">
    <Content />
  </div>
</section>

{
  next.id !== entry.id && (
    <a class="next" href={`/work/${next.id}/`} data-case={next.id}>
      <span class="label">Next project</span>
      <span class="title">{next.data.title} →</span>
    </a>
  )
}
