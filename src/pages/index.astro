---
import Base from '../layouts/Base.astro';
import CaseStudy from '../components/CaseStudy.astro';
import { site, experience, toolkit } from '../data/site';
import { getWork } from '../lib/work';

const work = await getWork();
---

<Base>
  <section class="hero" aria-labelledby="intro">
    <p class="label">{site.name}</p>
    <h1 id="intro">Full stack developer building <em>dependable</em> business software.</h1>
    <p class="lede">
      Since 2013 I've built core banking, ERP and legal-tech systems, mostly the internal tools a
      business runs on every day. Today I work remotely with {site.currentOrg} in Singapore, adding
      AI services to document and email workflows for law firms in Germany.
    </p>
    <ul class="meta label" role="list">
      <li>{site.location}</li>
      <li>Remote · {site.timezone}</li>
      <li><span class="dot" aria-hidden="true"></span>Now at {site.currentOrg}</li>
    </ul>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <h2 class="label" id="work-title">Selected work</h2>
    <ol class="work-list" role="list">
      {
        work.map((entry) => (
          <li>
            <a class="work-item" href={`/work/${entry.id}/`} data-case={entry.id}>
              <span class="period mono">{entry.data.period}</span>
              <div>
                <h3>{entry.data.title}</h3>
                <p class="summary">{entry.data.summary}</p>
                <p class="stack mono">{entry.data.stack.join(' / ')}</p>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" id="experience" aria-labelledby="experience-title">
    <h2 class="label" id="experience-title">Experience</h2>
    <ol class="exp" role="list">
      {
        experience.map((job) => (
          <li>
            <span class="period mono">{job.period}</span>
            <div>
              <h3>{job.role}</h3>
              <p class="org">{job.org}</p>
              <ul>
                {job.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" id="toolkit" aria-labelledby="toolkit-title">
    <h2 class="label" id="toolkit-title">Toolkit</h2>
    <dl class="toolkit">
      {
        toolkit.map((group) => (
          <div>
            <dt class="mono">{group.label}</dt>
            <dd>
              {group.items.map((item) => (
                <span>{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <h2 class="label" id="contact-title">Contact</h2>
    <div>
      <h3>Have a project or a role in mind?</h3>
      <p>Email is the quickest way to reach me, in English or Indonesian.</p>
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
      <ul class="links mono" role="list">
        {
          site.links.map((link) => (
            <li>
              <a href={link.href} rel="me">
                {link.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <dialog class="case-modal" id="case-modal" aria-labelledby="case-modal-title">
    <div class="case-modal-bar mono">
      <a href="/#work" data-permalink>Open as page</a>
      <form method="dialog">
        <button class="case-modal-close" type="submit">
          Close <span aria-hidden="true">✕</span>
        </button>
      </form>
    </div>
    <div class="case-modal-body"></div>
  </dialog>

  {
    work.map((entry, i) => (
      <template id={`case-${entry.id}`} data-page-title={`${entry.data.title} · ${site.name}`}>
        <CaseStudy
          entry={entry}
          next={work[(i + 1) % work.length]}
          level={2}
          titleId="case-modal-title"
        />
      </template>
    ))
  }
</Base>

<script>
  // Open case studies in a dialog on the homepage. Each link still points at the
  // standalone /work/<slug>/ page, which is what loads without JavaScript, on
  // modified clicks (new tab) and when someone opens a shared URL directly.
  const dialog = document.querySelector<HTMLDialogElement>('#case-modal');

  if (dialog) {
    const body = dialog.querySelector<HTMLElement>('.case-modal-body')!;
    const permalink = dialog.querySelector<HTMLAnchorElement>('[data-permalink]')!;
    const homeTitle = document.title;

    const caseIn = (state: unknown): string | undefined =>
      (state as { case?: string } | null)?.case;

    const show = (slug: string): boolean => {
      const template = document.querySelector<HTMLTemplateElement>(
        `template#case-${CSS.escape(slug)}`,
      );
      if (!template) return false;

      body.replaceChildren(template.content.cloneNode(true));
      body.scrollTop = 0;
      permalink.href = `/work/${slug}/`;
      document.title = template.dataset.pageTitle ?? homeTitle;
      if (!dialog.open) dialog.showModal();
      return true;
    };

    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-case]');
      const slug = link?.dataset.case;
      if (!slug || !show(slug)) return;

      event.preventDefault();
      // Switching projects inside the open dialog replaces the entry, so Back
      // always returns to the homepage in one step.
      const method = caseIn(history.state) ? 'replaceState' : 'pushState';
      history[method]({ case: slug }, '', `/work/${slug}/`);
    });

    dialog.addEventListener('close', () => {
      document.title = homeTitle;
      if (caseIn(history.state)) history.back();
    });

    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    window.addEventListener('popstate', (event) => {
      const slug = caseIn(event.state);
      if (slug) show(slug);
      else if (dialog.open) dialog.close();
    });
  }
</script>
